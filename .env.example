# =================================================================
# ফেসবুক পেজ স্মার্ট অটোমেশন সিস্টেম - পরিবেশ কনফিগারেশন (.env)
# =================================================================

# ১. Google Gemini AI কনফিগারেশন (https://aistudio.google.com থেকে ফ্রি পাওয়া যায়)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ২. Telegram Bot কনফিগারেশন (@BotFather থেকে বটের টোকেন এবং @userinfobot থেকে আপনার চ্যাট আইডি পাবেন)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here

# ৩. Facebook Meta Graph API ও Webhook কনফিগারেশন
# পেজের আইডি (Facebook Page Settings -> About / Page Transparency)
FB_PAGE_ID=your_facebook_page_id_here
# পেজ অ্যাক্সেস টোকেন (Meta Developer Portal -> Graph API Explorer -> Page Token)
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token_here
# ফেসবুক ওয়েব-হুক ভেরিফিকেশনের জন্য আপনার দেওয়া একটি গোপন কোড (যেকোনো শব্দ দিতে পারেন)
FB_VERIFY_TOKEN=my_secure_fb_webhook_token_2026
# ফেসবুক অ্যাপ সিক্রেট (ঐচ্ছিক, তবে সিগনেচার সিকিউরিটির জন্য ভালো)
FB_APP_SECRET=your_facebook_app_secret_here

# ৪. YouTube চ্যানেল ট্র্যাকিং কনফিগারেশন
# যে ইউটিউব চ্যানেল থেকে স্বয়ংক্রিয় পোস্ট বানাতে চান তার চ্যানেল আইডি (যেমন: UCxxxxxxxxxxxxxxxxxxxx)
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here
# প্রতি কত মিনিট পর পর নতুন ভিডিও চেক করবে (ডিফল্ট: 30 মিনিট)
YOUTUBE_CHECK_INTERVAL_MINUTES=30

# ৫. সার্ভার সেটিংস (লোকাল বা ক্লাউড)
HOST=0.0.0.0
PORT=8000
